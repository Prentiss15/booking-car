# การตั้งค่า Google OAuth 2.0 (สำหรับเข้าสู่ระบบด้วยปุ่ม Google Sign-In)
# สมัครและรับ Client ID / Client Secret ได้ที่: https://console.cloud.google.com/
# Authorized redirect URI: http://localhost:8000/admin/google_callback.php (หรือโดเมนจริงของคุณ)

GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret-here
# GOOGLE_REDIRECT_URI=https://yourdomain.com/admin/google_callback.php
